{
  "name": "sangha-education-center",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.28.2"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:init": "node scripts/init-env.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:check": "docker compose config --quiet",
    "worker:dev": "node --import tsx worker/index.ts",
    "worker:check": "node --import tsx worker/index.ts --check",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate:local": "node --import tsx scripts/database.mts migrate",
    "db:seed": "prisma db seed",
    "db:new:local": "node --import tsx scripts/database.mts create",
    "db:status": "node --import tsx scripts/database.mts status",
    "db:test": "node --import tsx scripts/database.mts test",
    "db:test:sql": "node --import tsx --test tests/database/sql-wasm.test.ts tests/database/portal-sql.test.ts"
  },
  "dependencies": {
    "@fontsource/sarabun": "5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.5",
    "ioredis": "6.0.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
