# ตัวอย่างสำหรับเครื่องตนเองเท่านั้น ไม่มีsecretจริง
APP_ENV=local
POSTGRES_DB=sangha_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_LOCAL_ONLY
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://postgres:CHANGE_THIS_LOCAL_ONLY@127.0.0.1:5432/sangha_local
DIRECT_DATABASE_URL=postgresql://postgres:CHANGE_THIS_LOCAL_ONLY@127.0.0.1:5432/sangha_local
REDIS_URL=redis://127.0.0.1:6379
# Supabase Auth/Storage ตั้งในบทที่เกี่ยวข้อง ไม่มีcredentialในบท05
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# บท06: ฐานสมมติใหม่เท่านั้น ไม่ใช้ DATABASE_URL ของแอปสำหรับ seed/reset
CH06_DATABASE_URL=postgresql://postgres:CHANGE_THIS_LOCAL_ONLY@127.0.0.1:5432/sangha_ch06_demo
CH06_TEST_DATABASE_URL=postgresql://postgres:CHANGE_THIS_LOCAL_ONLY@127.0.0.1:5432/sangha_ch06_test

# Portal 0.7: runtime limited login role only, not the migration owner/service_role
PORTAL_DATABASE_URL=
PORTAL_ORIGIN=
PORTAL_LOGIN_PEPPER=
PORTAL_DATABASE_CA=
